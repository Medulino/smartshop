# Seguridad
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Activa HTTPS forzado, cookies seguras y HSTS cuando la app se sirve por
# HTTPS. Sin valor: activo solo si DEBUG=False.
ENABLE_HTTPS=True

# Cuenta de administrador. Se crea al arrancar (start.sh -> inicializar.py)
# si no existe superusuario. OBLIGATORIO: sin ADMIN_PASSWORD el arranque
# falla a propósito (nunca se usa un password por defecto).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smartshop.com
ADMIN_PASSWORD=cambia-esto-por-una-password-muy-fuerte

# Proxies de confianza que reenvían X-Forwarded-For (p.ej. nginx), separados
# por comas. Vacío = sin proxy: se usa la IP real del cliente. En HTTPS
# (producción) también se confía en X-Forwarded-For.
TRUSTED_PROXIES=
# Confiar en X-Forwarded-For solo porque la conexión llegue por HTTPS.
# False si no hay proxy de confianza delante (evita IP spoofing en rate limits).
CONFIAR_XFF_EN_HTTPS=False

# Base de datos (PostgreSQL en el HOST, puerto 5433: el 5432 lo ocupa otro
# proyecto Docker de esta máquina). La app corre en Docker y llega al host vía
# host.docker.internal. Si la app corriera en el host, usar 127.0.0.1.
DB_NAME=compra_db
DB_USER=medulino
DB_PASSWORD=cambia-esto-por-una-password-segura
DB_HOST=host.docker.internal
DB_PORT=5433

# IA
GEMINI_API_KEY=tu-clave-de-google-gemini-aqui

# Alertas de errores por email (opcional): sin estas variables no se envía
# nada y la app funciona igual. Con un SMTP (p.ej. Gmail con contraseña de
# aplicación) los errores 500 llegan a ADMINS.
# ADMINS=Tu Nombre:tu-correo@gmail.com
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion
# SERVER_EMAIL=errores@comprainteligente.local